PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/educore_ai
JWT_SECRET=change_this_to_a_random_32_char_string
JWT_EXPIRES_IN=1d

# AI Providers (dual-provider fallback: OpenAI → Anthropic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=educore-ai-uploads
AWS_BUCKET_REGION=us-east-1

# Cloudinary (alternative to S3 for media)
CLOUDINARY_URL=

# Payment
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# Email (SMTP — use Gmail App Password or SendGrid SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@educore.ng

# SMS — Termii (Nigerian gateway)
TERMII_API_KEY=
TERMII_SENDER_ID=EduCore
TERMII_BASE_URL=https://api.ng.termii.com

# WhatsApp Business Cloud API (Meta)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Platform super admin (run: node scripts/seedSuperAdmin.js)
SUPER_ADMIN_EMAIL=admin@educore.ng
SUPER_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
