  "exam_patterns": {
    "waec": {
      "description": "West African Examinations Council format",
      "structure": { "objective": 50, "theory": 6, "practical": "where applicable" },
      "duration_minutes": 180
    },
    "neco": {
      "description": "National Examinations Council format",
      "structure": { "objective": 60, "theory": 5 },
      "duration_minutes": 180
    },
    "jamb": {
      "description": "Joint Admissions and Matriculation Board (UTME) format",
      "structure": { "mcq_only": 40 },
      "duration_minutes": 120
    },
    "internal": {
      "description": "School-based continuous assessment and terminal exam",
      "structure": { "ca_weight": 30, "exam_weight": 70 },
      "duration_minutes": 90
    },
    "ca": {
      "description": "Continuous Assessment – class tests and assignments",
      "structure": { "tests": 2, "assignments": 2, "projects": 1 },
      "duration_minutes": 40
    }
  },
